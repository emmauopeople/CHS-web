{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chs.example/contracts/sync/v1/encounter-addendum.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "localEncounterId",
    "noteText",
    "createdByLocalActorId",
    "createdAt"
  ],
  "properties": {
    "localEncounterId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "noteText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "createdByLocalActorId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/utcTimestamp"
    }
  }
}
