{
  "name": "@chs/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "pg": "8.22.0"
  },
  "scripts": {
    "build": "node src/validate-migrations.mjs",
    "lint": "node scripts/check-syntax.mjs",
    "migrate": "node --env-file-if-exists=../../.env src/migrate.mjs",
    "test": "node --test test/migration-files.test.mjs test/backup-restore-rehearsal.test.mjs",
    "test:backup-restore": "node --env-file-if-exists=../../.env scripts/backup-restore-rehearsal.mjs",
    "test:integration": "node --env-file-if-exists=../../.env --test test/integration/schema.integration.test.mjs",
    "typecheck": "node scripts/check-syntax.mjs"
  }
}
