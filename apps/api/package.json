{
  "name": "@chs/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "scripts": {
    "admin:operations-access:provision": "node --env-file-if-exists=../../.env --import tsx src/commands/provision-operations-access.ts",
    "admin:screening-context:provision": "node --env-file-if-exists=../../.env --import tsx src/commands/provision-screening-context.ts",
    "admin:installation:enroll": "node --env-file-if-exists=../../.env --import tsx src/commands/enroll-installation.ts",
    "admin:installation:revoke": "node --env-file-if-exists=../../.env --import tsx src/commands/manage-installation-credential.ts revoke",
    "admin:installation:rotate": "node --env-file-if-exists=../../.env --import tsx src/commands/manage-installation-credential.ts rotate",
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/main.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:documentation": "vitest run test/api-documentation.test.ts",
    "test:integration": "node --env-file-if-exists=../../.env ./node_modules/vitest/vitest.mjs run test/integration --no-file-parallelism",
    "test:load": "node --env-file-if-exists=../../.env --import tsx test/load/api-load-evidence.ts",
    "test:recovery": "node --env-file-if-exists=../../.env --import tsx test/recovery/sync-recovery-evidence.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "local:auth:grant": "node --env-file-if-exists=../../.env --import tsx src/commands/provision-local-reviewer.ts"
  }
}
