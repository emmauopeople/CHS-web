{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chs.example/contracts/sync/v1/referral.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "localPatientId",
    "localEncounterId",
    "localProtocolVersionId",
    "reasonCodes",
    "reasonText",
    "urgency",
    "destinationName",
    "dueDate",
    "status",
    "createdByLocalActorId",
    "createdAt",
    "updatedByLocalActorId",
    "updatedAt",
    "closedByLocalActorId",
    "closedAt",
    "closureReason"
  ],
  "properties": {
    "localPatientId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "localEncounterId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "localProtocolVersionId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "reasonCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "\\S"
      }
    },
    "reasonText": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "urgency": {
      "enum": ["STANDARD", "URGENT"]
    },
    "destinationName": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "dueDate": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/localDate"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": ["OPEN", "CONTACTED", "SEEN", "UNABLE_TO_CONFIRM", "CLOSED"]
    },
    "createdByLocalActorId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "createdAt": {
      "$ref": "common.schema.json#/$defs/utcTimestamp"
    },
    "updatedByLocalActorId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "updatedAt": {
      "$ref": "common.schema.json#/$defs/utcTimestamp"
    },
    "closedByLocalActorId": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "closedAt": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/utcTimestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "closureReason": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
