CHS_PORTAL_HOST=chsweb.servicecam.org
CHS_API_HOST=api-chs.servicecam.org
CHS_AUTH_HOST=auth-chs.servicecam.org
CHS_LOCAL_PORT=8090
# Public provider settings. Set all three API values together before portal use.
OPERATIONS_OIDC_ISSUER=https://auth-chs.servicecam.org/realms/chs
OPERATIONS_OIDC_AUDIENCE=chs-operations-api
OPERATIONS_OIDC_JWKS_URL=https://auth-chs.servicecam.org/realms/chs/protocol/openid-connect/certs
# These public SPA settings are embedded at image build time.
VITE_OPERATIONS_OIDC_AUTHORIZATION_ENDPOINT=https://auth-chs.servicecam.org/realms/chs/protocol/openid-connect/auth
VITE_OPERATIONS_OIDC_TOKEN_ENDPOINT=https://auth-chs.servicecam.org/realms/chs/protocol/openid-connect/token
VITE_OPERATIONS_OIDC_END_SESSION_ENDPOINT=https://auth-chs.servicecam.org/realms/chs/protocol/openid-connect/logout
VITE_OPERATIONS_OIDC_CLIENT_ID=chs-operations-web
VITE_OPERATIONS_OIDC_SCOPE=openid profile
