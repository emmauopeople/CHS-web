resolver 127.0.0.11 valid=5s ipv6=off;
upstream chs_api {
    zone chs_api 64k;
    server api:3000 resolve;
}
upstream chs_identity {
    zone chs_identity 64k;
    server identity:8080 resolve;
}

map $http_origin $chs_cors_origin {
    default "";
    "https://${CHS_PORTAL_HOST}" "https://${CHS_PORTAL_HOST}";
}

server {
    listen 80 default_server;
    server_name _;
    location = /health/gateway { access_log off; return 200 "ok\n"; }
    location / { return 404; }
}

server {
    listen 80;
    server_name ${CHS_PORTAL_HOST};
    server_tokens off;
    root /usr/share/nginx/html;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control "no-store" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;
    location / { try_files $uri $uri/ /index.html; }
}

server {
    listen 80;
    server_name ${CHS_API_HOST};
    server_tokens off;
    client_max_body_size 1m;
    # Clinical paths and batch IDs must not be retained in gateway access logs.
    access_log off;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "no-store" always;
    add_header Access-Control-Allow-Origin $chs_cors_origin always;
    add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
    add_header Access-Control-Allow-Headers "Authorization, Content-Type, Accept" always;
    add_header Vary Origin always;

    location /api/v1/ {
        if ($request_method = OPTIONS) { return 204; }
        proxy_pass http://chs_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 125s;
        proxy_send_timeout 125s;
        proxy_buffering off;
    }
    location = /health/live { proxy_pass http://chs_api; }
    location = /health/ready { proxy_pass http://chs_api; }
    location / { return 404; }
}

server {
    listen 80;
    server_name ${CHS_AUTH_HOST};
    server_tokens off;
    access_log off;
    add_header Cache-Control "no-store" always;
    location /realms/chs/ {
        proxy_pass http://chs_identity;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location /resources/ { proxy_pass http://chs_identity; }
    # Admin console is deliberately local-only through compose.identity-admin.yaml.
    location / { return 404; }
}
